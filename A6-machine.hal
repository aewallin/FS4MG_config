# -----------------------------
# EtherCAT and Motion Config
# -----------------------------
# from https://github.com/aewallin/FS4MG_config

# Load kinematics and motion modules
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# Load EtherCAT configuration from XML
loadusr -W lcec_conf ethercat-conf.xml

# Load EtherCAT and CIA402 drivers
loadrt lcec
loadrt cia402 count=3
# for decoding drive digital inputs
loadrt bitslice count=3 personality=21,21,21
# for ORing together 3D probe and toolsetter
loadrt logic count=1 personality=0x204
# spindle speed conv to s32 for ethercat
loadrt conv_float_s32 count=1
# s32 from ethercat converted to float for linuxcnc
# spindle rpm, torque for x, y, z
loadrt conv_s32_float names=spindle_s32_float,t2f_x,t2f_y,t2f_z

# spindle mux2 for controlword
loadrt mux2 names=mux2.spindle-enable 
loadrt conv_float_u32 count=1
# spind at speed?
loadrt near names=spindlenear

# Add EtherCAT and motion processing functions to the servo thread
addf    lcec.read-all           servo-thread
addf    cia402.0.read-all       servo-thread
addf    cia402.1.read-all       servo-thread
addf    cia402.2.read-all       servo-thread
addf    motion-command-handler  servo-thread
addf    motion-controller       servo-thread
addf    bitslice.0              servo-thread
addf    bitslice.1              servo-thread
addf    bitslice.2              servo-thread
addf    logic.0                 servo-thread
addf    mux2.spindle-enable     servo-thread
addf    conv-float-s32.0        servo-thread
addf    spindle_s32_float       servo-thread
addf    conv-float-u32.0        servo-thread
addf    spindlenear             servo-thread
addf    cia402.0.write-all      servo-thread
addf    cia402.1.write-all      servo-thread
addf    cia402.2.write-all      servo-thread
addf    lcec.write-all          servo-thread

# Enable EMC control
# safety-relay enabled on lcec.0.3.din-0
net ext-estop-signal  =>  iocontrol.0.emc-enable-in <= lcec.0.3.din-0

# -----------------------------
# AXIS X Y Z Configuration
# -----------------------------

# Set CIA402 into Profile Position Mode
setp cia402.0.csp-mode 1
setp cia402.1.csp-mode 1
setp cia402.2.csp-mode 1

setp cia402.0.pos-scale [JOINT_0]POS_SCALE
setp cia402.1.pos-scale [JOINT_0]POS_SCALE
setp cia402.2.pos-scale [JOINT_0]POS_SCALE

setp joint.0.jog-accel-fraction 0.3
setp joint.1.jog-accel-fraction 0.5
setp joint.2.jog-accel-fraction 0.5

#***********************************
# Motion signal mappings for axis X
#***********************************
net x-enable-cmd     joint.0.amp-enable-out   => joint.0.cia-enable-in
net x-enable         joint.0.cia-enable-out   => cia402.0.enable
net x-amp-fault      joint.0.amp-fault-in     <= cia402.0.drv-fault
net x-pos-cmd        joint.0.motor-pos-cmd    => cia402.0.pos-cmd          => joint.0.cia-pos-cmd
net x-vel-cmd        joint.0.vel-cmd          => cia402.0.velocity-cmd     => joint.0.cia-velocity-cmd
net j0-act-pos       cia402.0.pos-fb          => joint.0.cia-pos-fb-in
net j0-feedback      joint.0.cia-pos-fb-out   => joint.0.motor-pos-fb
net j0-home          joint.0.cia-home         => cia402.0.home
net j0-homed         cia402.0.stat-homed      => joint.0.cia-stat-homed
net j0-homing        cia402.0.stat-homing     => joint.0.cia-stat-homing
net j0-homing-error  cia402.0.stat-homing-error => joint.0.cia-stat-homing-error
net j0-drive-fault   cia402.0.stat-fault      => joint.0.cia-stat-fault
net j0-op-enabled    cia402.0.stat-op-enabled => joint.0.cia-stat-op-enabled
setp joint.0.request-custom-homing 1
setp joint.0.cia-timeout-ms 60000
setp lcec.0.A6X.homing-method [JOINT_0]CIA402_HOMING_METHOD
setp lcec.0.A6X.homing-high-velocity [JOINT_0]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.A6X.homing-low-velocity [JOINT_0]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.A6X.homing-acceleration [JOINT_0]CIA402_HOMING_ACCELERATION
# CIA402 driver to EtherCAT mapping
net x-controlword         cia402.0.controlword            => lcec.0.A6X.control-word
net x-drv-target-pos      cia402.0.drv-target-position    => lcec.0.A6X.target-position
net x-mode-of-operation   cia402.0.opmode                 => lcec.0.A6X.control-mode  
# EtherCAT to CIA402 driver mapping
net x-statusword      lcec.0.A6X.status-word       => cia402.0.statusword  
net x-drv-act-mode    lcec.0.A6X.mode-display      => cia402.0.opmode-display => joint.0.cia-opmode-display
net x-drv-act-pos     lcec.0.A6X.pos-actual        => cia402.0.drv-actual-position 
net x-drv-act-vel     lcec.0.A6X.vel-actual        => cia402.0.drv-actual-velocity 
net x-drv-di          lcec.0.A6X.di-status         => bitslice.0.in
net x-di4             bitslice.0.out-19
# 3D wireless probe connected to DI5
net x-di5             bitslice.0.out-20

#***********************************
# Motion signal mappings for axis Y
#***********************************
net y-enable-cmd     joint.1.amp-enable-out   => joint.1.cia-enable-in
net y-enable         joint.1.cia-enable-out   => cia402.1.enable
net y-amp-fault      joint.1.amp-fault-in     <= cia402.1.drv-fault
net y-pos-cmd        joint.1.motor-pos-cmd    => cia402.1.pos-cmd => joint.1.cia-pos-cmd
net y-vel-cmd        joint.1.vel-cmd          => cia402.1.velocity-cmd   joint.1.cia-velocity-cmd
net j1-act-pos       cia402.1.pos-fb          => joint.1.cia-pos-fb-in
net j1-feedback      joint.1.cia-pos-fb-out   => joint.1.motor-pos-fb
net j1-home          joint.1.cia-home         => cia402.1.home
net j1-homed         cia402.1.stat-homed      => joint.1.cia-stat-homed
net j1-homing        cia402.1.stat-homing     => joint.1.cia-stat-homing
net j1-homing-error  cia402.1.stat-homing-error => joint.1.cia-stat-homing-error
net j1-drive-fault   cia402.1.stat-fault      => joint.1.cia-stat-fault
net j1-op-enabled    cia402.1.stat-op-enabled => joint.1.cia-stat-op-enabled
setp joint.1.request-custom-homing 1
setp joint.1.cia-timeout-ms 30000
setp lcec.0.A6Y.homing-method [JOINT_1]CIA402_HOMING_METHOD
setp lcec.0.A6Y.homing-high-velocity [JOINT_1]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.A6Y.homing-low-velocity [JOINT_1]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.A6Y.homing-acceleration [JOINT_1]CIA402_HOMING_ACCELERATION
# CIA402 driver to EtherCAT mapping
net y-controlword         cia402.1.controlword            => lcec.0.A6Y.control-word
net y-drv-target-pos      cia402.1.drv-target-position    => lcec.0.A6Y.target-position
net y-mode-of-operation   cia402.1.opmode                 => lcec.0.A6Y.control-mode  
# EtherCAT to CIA402 driver mapping
net y-statusword      lcec.0.A6Y.status-word       => cia402.1.statusword  
net y-drv-act-mode    lcec.0.A6Y.mode-display      => cia402.1.opmode-display => joint.1.cia-opmode-display
net y-drv-act-pos     lcec.0.A6Y.pos-actual        => cia402.1.drv-actual-position 
net y-drv-act-vel     lcec.0.A6Y.vel-actual        => cia402.1.drv-actual-velocity 
net y-drv-di          lcec.0.A6Y.di-status         => bitslice.1.in
net y-di4             bitslice.1.out-19
# 3D wireless probe connected to DI5
net y-di5             bitslice.1.out-20

#***********************************
# Motion signal mappings for axis Z
#***********************************
net z-enable-cmd     joint.2.amp-enable-out   => joint.2.cia-enable-in
net z-enable         joint.2.cia-enable-out   => cia402.2.enable
net z-amp-fault      joint.2.amp-fault-in     <= cia402.2.drv-fault
net z-pos-cmd        joint.2.motor-pos-cmd    => cia402.2.pos-cmd => joint.2.cia-pos-cmd
net z-vel-cmd        joint.2.vel-cmd          => cia402.2.velocity-cmd   joint.2.cia-velocity-cmd
net j2-act-pos       cia402.2.pos-fb          => joint.2.cia-pos-fb-in
net j2-feedback      joint.2.cia-pos-fb-out   => joint.2.motor-pos-fb
net j2-home          joint.2.cia-home         => cia402.2.home
net j2-homed         cia402.2.stat-homed      => joint.2.cia-stat-homed
net j2-homing        cia402.2.stat-homing     => joint.2.cia-stat-homing
net j2-homing-error  cia402.2.stat-homing-error => joint.2.cia-stat-homing-error
net j2-drive-fault   cia402.2.stat-fault      => joint.2.cia-stat-fault
net j2-op-enabled    cia402.2.stat-op-enabled => joint.2.cia-stat-op-enabled
setp joint.2.request-custom-homing 1
setp joint.2.cia-timeout-ms 60000
setp lcec.0.A6Z.homing-method [JOINT_2]CIA402_HOMING_METHOD
setp lcec.0.A6Z.homing-high-velocity [JOINT_2]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.A6Z.homing-low-velocity [JOINT_2]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.A6Z.homing-acceleration [JOINT_2]CIA402_HOMING_ACCELERATION
# CIA402 driver to EtherCAT mapping
net z-controlword         cia402.2.controlword            => lcec.0.A6Z.control-word
net z-drv-target-pos      cia402.2.drv-target-position    => lcec.0.A6Z.target-position
net z-mode-of-operation   cia402.2.opmode                 => lcec.0.A6Z.control-mode  
# EtherCAT to CIA402 driver mapping
net z-statusword      lcec.0.A6Z.status-word       => cia402.2.statusword  
net z-drv-act-mode    lcec.0.A6Z.mode-display      => cia402.2.opmode-display => joint.2.cia-opmode-display
net z-drv-act-pos     lcec.0.A6Z.pos-actual        => cia402.2.drv-actual-position 
net z-drv-act-vel     lcec.0.A6Z.vel-actual        => cia402.2.drv-actual-velocity 
net z-drv-di          lcec.0.A6Z.di-status         => bitslice.2.in
net z-di4             bitslice.2.out-19
# 3D wireless probe connected to DI5
net z-di5             bitslice.2.out-20

#*******************
# PROBE
#*******************
# OR together probes
# 3D probe is x-di4
# toolsetter is x-di5
net x-di4 logic.0.in-00
net x-di5 logic.0.in-01
net motion-probe logic.0.or => motion.probe-input


#*******************
#  ETHERCAT SPINDLE 
#*******************

# Spindle cooling fan
# lcec.0.1.dout-0   controls relay for +24VDC to spindle cooling fan
# spindle.M.on OUT BIT TRUE when spindle should rotate.
net spindle-on spindle.0.on => lcec.0.1.dout-0

# VFD controlword
# lcec.0.MX2.srv-cia-controlword
#  OFF: 10
#   ON: 15
setp mux2.spindle-enable.in0 10
setp mux2.spindle-enable.in1 15
net spindle-conv        mux2.spindle-enable.out     => conv-float-u32.0.in 
net spindle-ctrl-cmd    conv-float-u32.0.out        => lcec.0.MX2.srv-cia-controlword 
net spindle-on          mux2.spindle-enable.sel

# VFD RPM setting
# spindle.M.speed-out OUT FLOAT Desired spindle speed in rotations per minute.
net spindle-speed        spindle.0.speed-out     conv-float-s32.0.in  
net spindle-speed-s32    conv-float-s32.0.out    lcec.0.MX2.srv-target-vl

# VFD RPM monitoring
# lcec.0.MX2.srv-actual-vl OUT s32 indicates actual spindle rpm
# spindle.M.at-speed IN BIT Motion will pause until this pin is TRUE,
setp spindlenear.scale  1.1
net spindle-speed spindlenear.in1
net spindle-act-speed-s32 lcec.0.MX2.srv-actual-vl  spindle_s32_float.in  
net spindle-act-speed spindle_s32_float.out spindlenear.in2
net spindle-at-speed spindlenear.out spindle.0.at-speed

# VFD Fault
# spindle.M.amp-fault-in  IN BIT Should be driven TRUE if an external fault is detected
# lcec.0.MX2.srv-error-code  u32 should be zero?

#*******************
#  END 
#*******************
